{
  "name": "dsh-modular-code-structure",
  "version": "1.0.0",
  "description": "Modular Code Structure as a DSH skill: one folder per page with frontend/ and backend/ inside, every file at or under 300 lines, 400 hard cap.",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-skill",
    "skill",
    "modular",
    "page-structure",
    "code-quality"
  ],
  "license": "MIT",
  "author": "Sean Montecillo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delmontecillo/dsh-modular-code-structure.git"
  },
  "homepage": "https://github.com/delmontecillo/dsh-modular-code-structure#readme",
  "bugs": {
    "url": "https://github.com/delmontecillo/dsh-modular-code-structure/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
